# Copy to .env (npm run setup:env does this and fills in the local database URLs).
# Placeholder values only. Never commit a real .env file.

NODE_ENV=development
PORT=4000
# Public URL of the application; used in email links and the WebSocket origin check.
APP_ORIGIN=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated. Usually empty.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (1 behind nginx or a load balancer).
TRUST_PROXY=0
LOG_LEVEL=info

DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/peerconnect
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/peerconnect_test

# Email. With SMTP_HOST empty in development, emails print to the server console.
# Production refuses to start without SMTP_HOST.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="PeerConnect <no-reply@example.com>"

# Uploaded files. Must be outside any publicly served directory.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Optional AI features. Leave the key empty to disable them; the rest of the app is unaffected.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=20

# Optional: POST unhandled server errors as JSON to this URL.
ERROR_WEBHOOK_URL=
