{
  "name": "@peerconnect/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate:prod": "node dist/cli/migrate.js",
    "seed:prod": "node dist/cli/seed.js",
    "admin:create:prod": "node dist/cli/create-admin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --conditions=source --env-file-if-exists=../.env src/cli/migrate.ts",
    "seed": "tsx --conditions=source --env-file-if-exists=../.env src/cli/seed.ts",
    "seed:demo": "tsx --conditions=source --env-file-if-exists=../.env src/cli/seed-demo.ts",
    "admin:create": "tsx --conditions=source --env-file-if-exists=../.env src/cli/create-admin.ts",
    "openapi": "tsx --conditions=source --env-file-if-exists=../.env src/cli/openapi.ts"
  },
  "dependencies": {
    "@peerconnect/model": "1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
